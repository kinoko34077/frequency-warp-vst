{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kinoko34077/frequency-warp-vst/blob/main/schemas/fw-ui-descriptors-v1.schema.json",
  "title": "Frequency Warp Generic Engine UI Descriptor V1 (R1 preflight only)",
  "description": "Data contract; native host authorization and DAW project binding are separate R2/R3 gates. Existing .fwengine v1 manifest is unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "engine",
    "bindings"
  ],
  "properties": {
    "schema": {
      "const": "frequency-warp-ui-descriptors-v1"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "bindings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_slot",
        "semantic_id",
        "label",
        "dimension",
        "canonical_unit",
        "min",
        "max",
        "default",
        "scale",
        "widget",
        "display_units",
        "codec_revision"
      ],
      "properties": {
        "host_slot": {
          "type": "integer",
          "minimum": 64,
          "maximum": 127
        },
        "semantic_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "dimension": {
          "enum": [
            "frequency",
            "ratio",
            "fraction",
            "signedRatio",
            "coordinate",
            "integer",
            "boolean"
          ]
        },
        "canonical_unit": {
          "enum": [
            "hz",
            "ratio",
            "fraction",
            "coordinate",
            "integer",
            "boolean"
          ]
        },
        "min": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000
        },
        "max": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000
        },
        "default": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000
        },
        "scale": {
          "enum": [
            "linear",
            "log",
            "discrete",
            "frequency-band",
            "frequency-with-zero"
          ]
        },
        "widget": {
          "enum": [
            "knob",
            "slider",
            "number",
            "select",
            "switch"
          ]
        },
        "display_units": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "codec_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "selector": {
          "type": "string",
          "pattern": "^#[A-Za-z][A-Za-z0-9_-]*$"
        },
        "snap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "values",
            "radius_normalized"
          ],
          "properties": {
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "number"
              }
            },
            "radius_normalized": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.25
            }
          }
        },
        "depends_on": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
